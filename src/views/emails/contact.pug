doctype html
html
  head
    meta(charset="UTF-8")
    meta(name="viewport" content="width=device-width, initial-scale=1.0")
    title New Contact Form Submission
    style
      :css
        body {
          font-family: Arial, sans-serif;
          line-height: 1.6;
          color: #333;
        }
        .container {
          max-width: 600px;
          margin: 0 auto;
          padding: 20px;
          border: 1px solid #ddd;
          border-radius: 5px;
        }
        .header {
          background-color: #333;
          color: white;
          padding: 20px;
          border-radius: 5px 5px 0 0;
        }
        .content {
          padding: 20px;
        }
        .footer {
          background-color: #f5f5f5;
          padding: 10px;
          text-align: center;
          font-size: 12px;
          border-radius: 0 0 5px 5px;
        }
        .field {
          margin-bottom: 15px;
        }
        .label {
          font-weight: bold;
          display: block;
          margin-bottom: 5px;
        }

  body
    .container
      .header
        h1 New Contact Form Submission
      
      .content
        .field
          span.label Name:
          p= name
        
        .field
          span.label Email:
          p
            a(href="mailto:" + email)= email
        
        .field
          span.label Message:
          p= message
      
      .footer
        p
          | This email was sent from 
          a(href=appUrl)= appUrl
        p
          | &copy; #{currentYear} Kelvin Kamara. All rights reserved.
