{
  "name": "kelvinkamara",
  "version": "1.0.0",
  "description": "Award-Winning Software Developer Portfolio",
  "main": "src/app.js",
  "scripts": {
    "test": "cross-env NODE_ENV=test mocha tests/**/{,**/}*.js",
    "start": "cross-env DEBUG=express:* node src/app.js",
    "dev": "cross-env DEBUG=express:* nodemon src/app.js --trace-warnings --legacy-watch",
    "dev:frontend": "concurrently \"cross-env DEBUG=express:* nodemon src/app.js --trace-warnings --legacy-watch\" \"cd frontend && npm run dev\"",
    "setup": "node setup.js",
    "model:generate": "cross-env NODE_ENV=development npx sequelize-cli model:generate",
    "migration:generate": "cross-env NODE_ENV=development npx sequelize-cli migration:generate",
    "seed:generate": "cross-env NODE_ENV=development npx sequelize-cli seed:generate",
    "migrate": "cross-env NODE_ENV=development npx sequelize-cli db:migrate",
    "migrate:test": "cross-env NODE_ENV=test npx sequelize-cli db:migrate --debug",
    "migrate:undo": "cross-env NODE_ENV=development npx sequelize-cli db:migrate:undo",
    "migrate:undo:all": "cross-env NODE_ENV=development npx sequelize-cli db:migrate:undo:all",
    "seed": "cross-env NODE_ENV=development npx sequelize-cli db:seed",
    "seed:all": "cross-env NODE_ENV=development npx sequelize-cli db:seed:all",
    "seed:all:test": "cross-env NODE_ENV=test npx sequelize-cli db:seed:all --debug",
    "seed:undo:all": "cross-env NODE_ENV=development npx sequelize-cli db:seed:undo:all",
    "seed:undo": "cross-env NODE_ENV=development npx sequelize-cli db:seed:undo"
  },
  "dependencies": {
    "axios": "^1.20.0",
    "bcrypt": "^5.1.1",
    "cookie-parser": "^1.4.4",
    "cors": "^2.8.5",
    "dotenv": "^8.2.0",
    "express": "^4.17.1",
    "express-async-handler": "^1.2.0",
    "express-minify-html": "^0.12.0",
    "express-rate-limit": "^8.0.1",
    "express-session": "^1.17.3",
    "http-status": "^2.1.0",
    "mailgun.js": "^14.1.1",
    "moment-timezone": "^0.5.48",
    "morgan": "^1.10.0",
    "multer": "^2.0.2",
    "mysql2": "^2",
    "nodemailer": "^7.0.6",
    "pug": "^3.0.2",
    "sanitize": "^2.1.0",
    "sequelize": "^6.13.0",
    "session-file-store": "^1.5.0"
  },
  "devDependencies": {
    "@faker-js/faker": "^10.1.0",
    "chai": "^4.3.7",
    "chai-http": "^4.4.0",
    "concurrently": "^9.1.2",
    "cross-env": "^7.0.3",
    "mocha": "^9.1.4",
    "nodemon": "^2.0.22",
    "sequelize-cli": "^6.6.2"
  }
}
