APP_NAME='Kelvin Kamara - Award-Winning Software Engineer'
# Generate with
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
APP_KEY='your-app-key-here-generate-with-openssl-rand-hex-32'
NODE_ENV=development
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://localhost:8000
ALLOWED_ORIGINS=http://localhost:3000

PORT=8000

# DB creds are set in ./config.json
# but also here for Docker usage
DB_HOST=mysql
DB_PASS=secret
DB_NAME=kelvinkamara
DB_USER=user
DB_PORT=3306

# When running the backend outside Docker, set MAIL_HOST=127.0.0.1 and
# MAIL_PORT to the published MailHog SMTP port (1025 by default).
MAIL_HOST=mailhog
MAIL_PORT=1025
MAIL_SECURE=false
MAIL_USER=
MAIL_PASS=
MAIL_FROM='Admin <admin@kelvinkamara.com>'
MAIL_TO=your-email@example.com
MAIL_SUBJECT='KelvinKamara.com Message Received'

# Cloudflare Turnstile CAPTCHA
TURNSTILE_SITEKEY=1x00000000000000000000AA
TURNSTILE_SECRET=1x0000000000000000000000000000000AA

ADMIN_PASSWORD=

STRIPE_PK=
STRIPE_SECRET=